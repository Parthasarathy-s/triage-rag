# Copy to .env and fill in. Never commit .env.
# Free read token from https://huggingface.co/settings/tokens (write access only needed to push the model)
HF_TOKEN=

# Optional overrides (defaults are in the code)
# GEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct          # hosted LLM on the HF free serverless tier
# GEN_LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct    # local fallback
# CLASSIFIER_DIR=models/ticket-classifier       # local path or a Hub repo id (user/repo)
# CHROMA_DIR=chroma_db
